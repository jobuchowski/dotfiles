#!/bin/bash

printf -v cmd '%q ' "$@"

lua_cmd=$(jq -Rn --arg cmd "$cmd" '$cmd')

hyprctl dispatch "hl.dsp.exec_cmd(
    $lua_cmd,
    {
        float = true,
        move = {
            'monitor_w*0.1',
            'monitor_h*0.15'
        },
        size = {
            'monitor_w*0.8',
            'monitor_h*0.7'
        }
    }
)"
